/*
 * Author       : neildaniel.a.2024.cse_raj609
 * Generated on : 06-Oct-2026 19:57:56
 * Version      : 1.0
 */
 application "Student Management System"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Student_Details
		{
			displayname = "Student Details"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have unique Roll_Number
			(
				type = number
				displayname = "Roll Number"
				maxchar = 9
				barcode = true
				camera = primary
				submit onscan = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Student_Name
			(
    			type = name
				displayname = "Student Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 value = {"Mr.","Mrs.","Ms.","Dr.","Prof."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have DOB
			(
    			type = date
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Email_ID
			(
    			type = email
				displayname = "Email ID"
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Address
			(
    			type = address
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Branch
			(
				type = picklist
				maxchar = 100
				values = {"CSE","IT","ECE"}
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Father_s_Name
			(
    			type = text
				displayname = "Father's Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Mother_s_Name
			(
    			type = text
				displayname = "Mother's Name"
    			description
    			[
    				type = tooltip
    			 	message = "Motherka naam"
    			]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Gender
			(
				type = radiobuttons
				maxchar = 100
				values = {"Male","Female"}
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Phone_Number
			(
    			type = phonenumber
				displayname = "Phone"
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			BIO
			(
    			type = textarea
				height = 100px
    			description
    			[
    				type = help_text
    			 	message = "Enter a brief BIO"
    			]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Decision_box
			(
    			type = checkbox
				displayname = "Decision box"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Skill_sets
			(
				type = list	
				displayname = "Skill sets"
				values = {"C","C++","JAVA","PYTHON"}
				sortorder = ascending
				height = 60px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Time
			(
    			type = time
				timedisplayoptions = "hh:mm:ss" 
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		default list Student_Details_Report
		{
			displayName = "Student Details Report"
			show all rows from Student_Details    
			(
				Student_Name  as "Student Name"
				Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Roll_Number as "Roll Number"
				Branch
				Father_s_Name as "Father's Name"
				Mother_s_Name as "Mother's Name"
				Gender
				Phone_Number as "Phone"
				(
					displayformat = plainnumber 
				)
				Email_ID as "Email ID"
				BIO
				Skill_sets as "Skill sets"
				DOB
				Time
				Decision_box as "Decision box"
			)
		}
	}




	share_settings
	{
			"Read"
			{
				name = "Read"
				type = Users_Permissions
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This profile will have read permission for all components\n"
			}
			"Write"
			{
				name = "Write"
				type = Users_Permissions
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This profile will have write permission for all components\n"
			}
			"Developer"
			{
				name = "Developer"
				type = Developer
				permissions = {Chat:false, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "Developer Profile\n"
			}
			"Administrator"
			{
				name = "Administrator"
				type = Users_Permissions
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This profile will have all the permissions.\n"
			}
			"Customer"
			{
				name = "Customer"
				type = Customer_Portal
				permissions = {Chat:false, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This is the default profile having only add and view permission.\n"
			}
			roles
			{
				"CEO"
				{
					description = "User belonging to this role can access data of all other users."
				}
			}
	}


	web
	{
		forms
		{
			form Student_Details
			{
				label placement = left
			}
		}
		reports
		{
			report Student_Details_Report
			{
				quickview
				(
					layout
					(
						datablock1
						(
							fields
							(
								Student_Name as "Student Name"
								Roll_Number as "Roll Number"
								Address
								Branch
								Father_s_Name as "Father's Name"
								Mother_s_Name as "Mother's Name"
								Skill_sets as "Skill sets"
							)
						)
					)
						menu
						(
							header
							(
								Edit 
								Duplicate 
								Delete 
							)
						record
						(
							Edit   	   
							Duplicate   	   
							Delete   	   
    					)
						)
    				action
    				(
						on click
						(
							View Record   	   
    					)
						on right click
						(
							Edit   	   
							Delete   	   
							Duplicate   	   
							View Record   	   
    					)
     				)
				)

				detailview
				(
					layout
					(
						datablock1
						(
							fields
							(
								Student_Name as "Student Name"
								Roll_Number as "Roll Number"
								Address
								Branch
								Father_s_Name as "Father's Name"
								Mother_s_Name as "Mother's Name"
								Gender
								Phone_Number as "Phone"
								Email_ID as "Email ID"
								BIO
								Skill_sets as "Skill sets"
								DOB
								Time
								Decision_box as "Decision box"
							)
						)
					)
						menu
						(
							header
							(
								Edit 
								Duplicate 
								Delete 
							)
						)
				)
			}
		}
		menu
		{
			space Space
			{
				displayname = "Space"
				icon = "objects-spaceship"

				section Student_Details
				{
					displayname = "Student Details"
					icon = "education-pencil-47"
					form  Student_Details
					{
						icon = "education-pencil-47"
					}
					report Student_Details_Report
					{
						icon = "tech-desktop"
					}
				}
				section App_Preferences
				{
					displayname = "App Preferences"
					icon = "design-app"
					systemcomponent
					{
						type = localization
						displayname = "Language Selection"
						icon = "education-language"
					}
					systemcomponent
					{
						type = connection
						displayname = "Integrations"
						icon = "tech-2-connection"
					}
				}
				section Approvals
				{
					displayname = "Approvals"
					icon = "ui-2-hourglass"
					systemcomponent
					{
						type = approval
						approval status = pending
						displayname = "Pending Tasks"
						icon = "ui-2-hourglass"
					}
					systemcomponent
					{
						type = approval
						approval status = completed
						displayname = "Completed Tasks"
						icon = "design-todo"
					}
				}
				section SharedAnalytics_Section
				{
					type = shared_user_report_section
					displayname = "Reports"
					icon = "business-chart-bar-33"
				}
			}
			preference
			{
				icon
				{
					style = outline
				}
			}
		}
		customize
		{
			font = "lato"
			color options
			{
				color = "11"
			}
			logo
			{
				preference = "app_icon"
				placement = "left"
			}
		}
	}
	phone
	{
		forms
		{
			form Student_Details
			{
				label placement = auto
			}
		}
		customize
		{
			layout = twocolumn
			font = "default"
			style = "3"
			color options
			{
				color = chryslerpurple
			}
			logo
			{
				preference = "none"
			}
		}
	}
	tablet
	{
		forms
		{
			form Student_Details
			{
				label placement = auto
			}
		}
		customize
		{
			layout = slidingpane
			font = "default"
			style = "3"
			color options
			{
				color = blue
			}
			logo
			{
				preference = "none"
			}
		}
	}
	translation
{
{"Language_Settings":{"LANGAGUE_WITH_LOGIN":"browser"}}
}
}
